HOST=127.0.0.1
PORT=8787
FLOW_API_KEY=replace-with-at-least-32-random-characters
# Generate: openssl rand -base64 32
FLOW_MASTER_KEY=replace-with-base64-encoded-32-byte-key
DATA_DIR=./data
PROFILE_DIR=./profiles
CHROME_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
FLOW_HEADLESS=false
FLOW_WORKER_CONCURRENCY=2
FLOW_JOB_TIMEOUT_MS=900000
FLOW_POLL_INTERVAL_MS=15000
FLOW_MAX_ATTEMPTS=4
FLOW_WEBHOOK_ALLOW_HTTP=false
FLOW_EMBEDDED_WORKER=true

# 9router prompt planning (OpenAI-compatible local gateway)
NINE_ROUTER_BASE_URL=http://127.0.0.1:20128/v1
NINE_ROUTER_API_KEY=
# Leave empty to select the best compatible Codex/combo model dynamically.
NINE_ROUTER_MODEL=
NINE_ROUTER_TIMEOUT_MS=90000

# Studio asset sources (see studio/bibles/military/SOURCES.md)
DVIDS_API_KEY=
NARA_API_KEY=
SMITHSONIAN_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Studio maps: maptiler (MAPTILER_KEY), gibs (NASA Blue Marble, no key), s2cloudless (Sentinel-2 2016), local
STUDIO_MAP_PROVIDER=
MAPTILER_KEY=

# Studio research behind a proxy (ANTHROPIC_BASE_URL set): search provider name enabled in 9router, used via /v1/search
STUDIO_SEARCH_MODEL=
# Word timings for 9router/Gemini voices: a speech-to-text model in 9router that returns word timestamps (e.g. a Whisper model).
# Empty = align against pauses measured in the audio.
STUDIO_ALIGN_MODEL=
# Rate-limited voices (9router/Gemini): seconds of narration per TTS request (0 = one request per segment), and max requests per minute (0 = no pacing)
STUDIO_VOICE_CHUNK_S=90
STUDIO_VOICE_RPM=0
# Footage planning: max clips downloaded per video (0 = 1.5x the clips the footage shots need, at least 6), candidates the planner reads per need,
# clips planned per need, shots one clip is expected to give
STUDIO_ASSET_MAX_DOWNLOADS=0
STUDIO_ASSET_CANDIDATES=10
STUDIO_ASSET_CLIPS_PER_NEED=4
STUDIO_ASSET_SHOTS_PER_CLIP=3
# Wall-clock budget for asset research (minutes); past it nothing new is downloaded or reviewed and unfilled shots go to Flow or G3
STUDIO_ASSET_TIME_BUDGET_MIN=30
