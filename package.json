{
  "name": "flow-api-platform",
  "version": "1.0.0-alpha.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "worker": "node --env-file-if-exists=.env src/worker.js",
    "login": "node --env-file-if-exists=.env scripts/login.js",
    "cookies": "node --env-file-if-exists=.env scripts/import-cookies.js",
    "accounts:init": "node --env-file-if-exists=.env scripts/init-five-accounts.js",
    "test": "node --test 'test/**/*.test.js'",
    "check": "node --check src/server.js && node --check src/worker.js",
    "ui:dev": "npm --prefix web run dev",
    "ui:build": "npm --prefix web run build",
    "studio": "node --no-warnings=ExperimentalWarning --env-file-if-exists=.env studio/cli.js",
    "test:studio": "node --no-warnings=ExperimentalWarning --test 'studio/test/**/*.test.js'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@fontsource/caveat-brush": "5.3.0",
    "@fontsource/gochi-hand": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/inter-tight": "5.3.0",
    "@fontsource/kalam": "5.3.0",
    "@fontsource/oswald": "5.3.0",
    "@fontsource/patrick-hand": "5.3.0",
    "d3-array": "3.2.4",
    "d3-geo": "3.1.1",
    "fastify": "^5.6.1",
    "gsap": "3.15.0",
    "hyperframes": "0.8.123",
    "jsonrepair": "3.15.0",
    "maplibre-gl": "6.12.0",
    "msedge-tts": "^2.0.8",
    "playwright-core": "^1.63.0",
    "three": "^0.186.1",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2",
    "zod": "^4.1.11"
  }
}
